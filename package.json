{
  "name": "solana-safesign",
  "version": "0.1.0",
  "description": "Open, reproducible Solana transaction safety fixtures and a deterministic validator.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "safesign": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "fixtures:check": "tsx src/cli.ts validate fixtures/v0.1",
    "check": "npm run typecheck && npm run test && npm run fixtures:check"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
